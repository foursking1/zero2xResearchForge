# Copy to .env for local use.  The real .env is ignored by Git.
PAPER_BENCH_ROOT=.

# Root layout: <PAPER_BENCH_DATA_ROOT>/<domain>/<card_id>/...
# Example: /mnt/d/paper-bench-data
PAPER_BENCH_DATA_ROOT=

# Required only to publish or download a private ModelScope dataset mirror. Keep
# personal or organization credentials in this ignored file, never in Git.
MODELSCOPE_DATASET_REPO=
# Set this to the approved immutable ModelScope tag or commit before an
# organization-wide release. `master` is the compatibility fallback.
MODELSCOPE_DATASET_REVISION=master
MODELSCOPE_API_TOKEN=

# Required only for LLM judging.  Any OpenAI-compatible chat-completions API
# is supported by the canonical judge.
JUDGE_API_URL=https://api.agtcloud.cn/v1/chat/completions
JUDGE_API_KEY=
JUDGE_MODEL=qwen3.7-max
JUDGE_WORKERS=1
